# Tilet Art Gallery — Supabase public browser configuration
# Copy this file to .env.local and replace the values with your project values.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Never put your database password, service_role key, or secret key in NEXT_PUBLIC_* variables.
